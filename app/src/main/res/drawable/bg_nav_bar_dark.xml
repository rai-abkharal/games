<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark crystal glass keeps the game visible while retaining contrast. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <solid android:color="#4A06142D" />
            <stroke android:width="1dp" android:color="#7A7DD3FC" />
        </shape>
    </item>

    <item
        android:left="8dp"
        android:top="2dp"
        android:right="8dp"
        android:bottom="38dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#1AFFFFFF" />
        </shape>
    </item>
</layer-list>
