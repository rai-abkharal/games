<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Top Status & Ad Banner Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Ad Banner Container (Seamless frame for Google AdMob Adaptive Banner) -->
        <FrameLayout
            android:id="@+id/bannerAdContainer"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_banner_container"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Player Profile & Global Coins HUD -->
        <LinearLayout
            android:id="@+id/profileContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bannerAdContainer">

            <TextView
                android:id="@+id/tvPlayerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guest"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Global Coins Pill -->
            <TextView
                android:id="@+id/tvTotalCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_stats_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="🪙 100"
                android:textColor="#B45309"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Current Game Title & Metadata -->
        <LinearLayout
            android:id="@+id/gameTitleContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:gravity="end"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@id/tvHighScore"
            app:layout_constraintStart_toEndOf="@id/profileContainer"
            app:layout_constraintTop_toBottomOf="@id/bannerAdContainer">

            <TextView
                android:id="@+id/tvGameTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Game Title"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGameMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 of 16 • Arcade"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- High Score Badge -->
        <TextView
            android:id="@+id/tvHighScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_gold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="🏆 0"
            android:textColor="#B45309"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/gameTitleContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/gameTitleContainer" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ViewPager2 for Vertical TikTok Game Swiping -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- Clean In-Game Action HUD (Right side: ONLY Like Button) -->
    <LinearLayout
        android:id="@+id/inGameHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Favorite / Like Button -->
        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="Like / Favorite Game"
            android:elevation="6dp"
            android:src="@drawable/ic_heart"
            app:tint="#64748B" />
    </LinearLayout>

    <!-- Firmly Docked Bottom Navigation Bar (Solid pinned to bottom edge) -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- All Games Tab -->
        <LinearLayout
            android:id="@+id/navAllGames"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavAll"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_gamepad"
                app:tint="#6366F1" />

            <TextView
                android:id="@+id/tvNavAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Games"
                android:textColor="#6366F1"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Trending Tab -->
        <LinearLayout
            android:id="@+id/navTrending"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavTrending"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_flame"
                app:tint="#94A3B8" />

            <TextView
                android:id="@+id/tvNavTrending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trending"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Favorites Tab -->
        <LinearLayout
            android:id="@+id/navFavorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavFav"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_star"
                app:tint="#94A3B8" />

            <TextView
                android:id="@+id/tvNavFav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Favorites"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Settings Tab -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavSettings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_settings"
                app:tint="#94A3B8" />

            <TextView
                android:id="@+id/tvNavSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Global Loading Spinner -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="#6366F1"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>