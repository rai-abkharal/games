# Node dependencies
node_modules/
**/node_modules/

# Build artifacts
dist/
**/dist/
frontend/build/
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.idea/
frontend/android/.gradle/
frontend/android/local.properties

# Environment & Logs
.env
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# System Generated
.system_generated/

# Per-build bundle manifests. Derived entirely from the game files beside them:
# the server generates any that are missing, and deploy.sh pre-generates them
# all, so committing them would only add churn on every game upload.
backend/public/games/**/bundle.json

# Runtime catalogue state (admin uploads must survive Git deployments)
backend/catalog/games.runtime.json
backend/catalog/deleted_games.json
backend/catalog/ads_config.json
security-data/
backend/security-data/
.tmp/
*.sqlite
*.sqlite-wal
*.sqlite-shm
.certs/

# Local developer environment
local.properties
*.tmp-*
