NODE_ENV=production
PORT=3000
# Separate HTTPS origins. Reverse proxy must preserve Host.
ADMIN_ORIGIN=https://admin.example.com
PREVIEW_ORIGIN=https://preview.example.net
BASE_URL=https://games.example.com
PUBLIC_DIR=/var/www/games-platform/backend/public
ADMIN_SECURITY_DB=/var/lib/swipe-play/admin.sqlite
ADMIN_STAGING_DIR=/var/lib/swipe-play/uploads
# Set ONLY to the actual trusted reverse proxy addresses.
TRUST_PROXY=loopback
# Configure these before enabling email password resets. Never commit real values.
SMTP_URL=smtps://username:password@mail.example.com:465
ADMIN_MAIL_FROM=Swipe Play Admin <admin@example.com>
